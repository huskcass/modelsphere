# Values for llm-slo-decision-gen: the two image addresses (one chart, two
# images -- see the note in observability/alert-webhook/images.yaml.gotmpl) and
# the slo-api switch.
decisionGen:
  image:
    repository: {{ .Values.registry }}/llm-scaler-decision-gen
sloApi:
  # On. The chart ships it off, because its published image looked for
  # LLMSLORequirement under inference.x-k8s.io while the CRDs were moving to
  # inference.modelsphere.dev, and would have found nothing. From {{ .Values.versions.sloApi }}
  # the image asks the API server which group it serves and uses that, so it
  # works on a cluster on either side of that move -- which both of ours still
  # are. Hence the tag here rather than the chart's default.
  enabled: true
  image:
    repository: {{ .Values.registry }}/llm-slo-api
    tag: {{ .Values.versions.sloApi | quote }}
